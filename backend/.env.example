# Provider Selection: "groq" (Production Cloud AI), "ollama" (Local AI), "demo" (Deterministic Fallback)
LLM_PROVIDER=ollama

# Local Ollama Settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Groq Cloud Settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Demo Project Path & CORS Security
DEMO_PROJECT_PATH=../demo-project
ALLOWED_ORIGINS=https://code-lens-ai-topaz.vercel.app,http://localhost:5173
